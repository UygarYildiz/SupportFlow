# Self-hosted SupportFlow (docs/SELF_HOSTING.md). init.sh / init.ps1 create .env from this
# file with random values for the three secrets. Never commit .env.

# Secrets: generated by the init script.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
# Asked for once, by the first-run setup page. Useless after setup.
SETUP_TOKEN=

# Where the dashboard listens. 127.0.0.1 = this computer only; 0.0.0.0 = the local network
# too (put HTTPS in front before exposing it to the internet).
SUPPORTFLOW_BIND=127.0.0.1
SUPPORTFLOW_PORT=8080

# Sessions last this long before signing in again (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI model. `fake` writes fixed sample drafts and costs nothing; `live` uses Gemini with
# your own key from Google AI Studio (customer messages are then sent to Google).
LLM_MODE=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODE=fake
