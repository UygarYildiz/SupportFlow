# Copy to .env and adjust. Never commit .env.
# All values below are local development defaults, not secrets.

APP_ENV=development
LOG_LEVEL=INFO

# ADR-017. `demo`: synthetic NovaShop data and demo logins (development, live demo).
# `self_hosted`: one business's own installation (see deploy/selfhost/ and
# docs/SELF_HOSTING.md); first-run setup instead of demo data.
DEPLOYMENT_MODE=demo
# One-time code the first-run setup asks for; required for self_hosted production.
# SETUP_TOKEN=

# Postgres from compose.yaml is published on host port 5433
# (5432 is often taken by a locally installed Postgres).
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://supportflow:supportflow@localhost:5433/supportflow
TEST_DATABASE_URL=postgresql+psycopg://supportflow:supportflow@localhost:5433/supportflow_test

# Demo authentication. The default secret is for local development only;
# APP_ENV=production refuses to start without a random 32+ character value.
# JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password for the seeded demo users (scripts/seed_demo.py). Demo only.
DEMO_USER_PASSWORD=supportflow-demo

# Live demo (ADR-016): browser origins allowed to call the API, comma-separated.
# Leave empty locally (Vite proxies the API). Frontend build: VITE_API_BASE_URL.
# CORS_ALLOW_ORIGINS=https://supportflow-w7q.pages.dev

# LLM (ADR-009). `fake` is deterministic and free (tests, CI, public demo).
# `live` calls Gemini and needs GEMINI_API_KEY (Google AI Studio). Never commit the key.
LLM_MODE=fake
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3

# Policy RAG embeddings (ADR-014). `fake` is offline and free; `live` uses Gemini.
# After switching, re-index with `uv run poe ingest`.
EMBEDDING_MODE=fake
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Read-only MCP tools (ADR-015). `mcp`: the agent reads orders and ticket history through
# the in-process MCP server; `direct`: through the services (fallback).
AGENT_TOOL_TRANSPORT=mcp
MCP_TOOL_TIMEOUT_SECONDS=10
# Staff token the stdio MCP server (`uv run poe mcp`) acts with; `uv run poe mcp-token`.
# Usually set in the MCP client's config instead of here. Never commit a token.
# MCP_ACCESS_TOKEN=
